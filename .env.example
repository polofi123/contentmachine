# Local Supabase. Run `pnpm db:start`, then `pnpm exec supabase status` and copy
# the values in. The CLI's local keys are fixed and identical on every install,
# so there is nothing secret here — but .env* is gitignored regardless.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
