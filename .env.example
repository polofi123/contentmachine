# Local Supabase. Run `pnpm db:start`, then `pnpm exec supabase status` and copy
# the values in. The CLI's local keys are fixed and identical on every install,
# so there is nothing secret here — but .env* is gitignored regardless.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — the story read-back and the localised suggestions in MAKE.
# Genuinely optional: every measured observation is computed locally, so with
# this unset the story panel still works and the "Analyse story" button simply
# does not appear. Unlike the keys above, this one IS a secret.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. Override only if you know why.
# ANTHROPIC_MODEL=

# Optional — automatic video analysis ("Analyze with AI" on the research page).
# Create a key in Google AI Studio. This one IS a secret. Without it the button
# explains how to set it up and manual import keeps working.
GEMINI_API_KEY=
# Defaults to gemini-3.5-flash-lite (fast, cheap). gemini-3.8-flash is stronger but much slower.
# GEMINI_MODEL=
# low (default, cheapest) | medium | high
# GEMINI_VIDEO_RESOLUTION=

# Optional — public YouTube statistics (views, likes, outlier score) via the
# official YouTube Data API v3. In Google Cloud Console: create a project,
# enable "YouTube Data API v3", create an API key (restrict it to that API).
# Free quota is 10,000 units/day; one refresh costs about 4. This one IS a secret.
YOUTUBE_API_KEY=
